FROM node:22-alpine

WORKDIR /usr/src/app

ENV NODE_ENV=production \
    NUXT_HOST=0.0.0.0 \
    NUXT_PORT=3000

COPY .output ./.output
COPY docker/entrypoint.sh /entrypoint.sh

RUN ln -sfn .nitro/hookable@6.1.1 .output/server/node_modules/hookable \
    && sed -i 's/\r$//' /entrypoint.sh \
    && chmod +x /entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", ".output/server/index.mjs"]
